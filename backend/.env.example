# backend/.env.example
# ==================================================================
# Salvatore Cakes - Backend Environment Variables
# ==================================================================
# Copy this file to `.env` and fill in real values:
#   copy .env.example .env         (Windows)
#   cp .env.example .env           (Mac/Linux)

# NEVER commit `.env` to git. `.env` is gitignored
# ==================================================================

# --- Core Django ---
# Generate with: python -c "from django.core.management.utils import gett_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=$vfyf7&x$qiy36*m1e)t%r(rhk+oj*2xrfmy7dy#z*#zzc%*hp
DEBUG=True

# --- Hosts ---
# Comma-seperated list. For production: yourdomain.com,www.yourdomain.com
# For Render: your-app.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1

# --- CORS (frontend origins) ---
# Comma-seperated list. For production: https://yourfrontend.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Email (SMTP) ---
# Gmail: use an App Password (16 chars, no spaces) - requires 2FA enabled
# Production: swap to SendGrid/Mailgun/Postmark later
EMAIL_HOST_USER=solomon2004solo@gmail.com
EMAIL_HOST_PASSWORD=grlshdahemwueube

# --- Frontend URL (used in email links) ---
# For production: https://yourfrontend.vercel.app
FRONTEND_BASE_URL=http://localhost:3000